# Machine-specific values read by scripts/codex-sync.sh. Copy to codex/local.env and fill in.
# Every key has a default: CS_USER=$(id -un), CS_PROJECTS_DIR=$HOME/Projects, CS_GITHUB_OWNER
# empty (the push wrapper then refuses every origin), CS_LAUNCH_LABEL=local.one-rulebook.codex-sync,
# CS_CODEX_PROFILE empty (the profile assertion is skipped), CS_PROJECTS empty (no checkout inspected).
CS_GITHUB_OWNER=your-github-user-or-org
CS_PROJECTS_DIR=/home/you/Projects
CS_LAUNCH_LABEL=local.one-rulebook.codex-sync
CS_CODEX_PROFILE=my-dev
CS_PROJECTS="/home/you/Projects/app-one /home/you/Projects/app-two"   # space-separated: paths with spaces cannot be listed
